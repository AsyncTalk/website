OPENAI_API_KEY=sk-your-openai-api-key

# Algolia episode search. The app id and search-only key are public and are
# baked into the site at build time; leave them unset to build without search.
PUBLIC_ALGOLIA_APP_ID=
PUBLIC_ALGOLIA_SEARCH_KEY=
PUBLIC_ALGOLIA_INDEX_NAME=asynctalk_posts
# Write key, only for `pnpm search:index`. Never expose it with a PUBLIC_ prefix.
ALGOLIA_ADMIN_API_KEY=
