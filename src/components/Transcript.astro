---
import { formatTimestamp, type TranscriptParagraph } from "../lib/srt";

interface Props {
  paragraphs: TranscriptParagraph[];
  srcUrl: string;
}

const { paragraphs, srcUrl } = Astro.props;
---

<details class="w-full rounded-xl border border-line px-4 py-4 sm:px-6 sm:py-5">
  <summary
    class="flex min-h-11 cursor-pointer select-none list-none items-baseline gap-3"
  >
    <span
      class="at-transcript-marker text-xs text-primary transition-transform"
      aria-hidden="true">▶</span
    >
    <h2 class="font-display text-2xl font-bold text-ink">本期文字稿</h2>
    <span class="text-xs text-mute">（{paragraphs.length} 段）</span>
  </summary>

  <a
    href={srcUrl}
    download
    class="mt-2 inline-flex min-h-11 items-center text-[13px] text-primary hover:underline"
  >
    下载 .srt 字幕文件 ↓
  </a>

  <div
    class="at-scrollbar mt-2 flex max-h-[32rem] flex-col gap-3.5 overflow-y-auto pr-3 leading-loose text-body"
  >
    {
      paragraphs.map((paragraph) => (
        <p class="flex gap-4">
          <span class="shrink-0 font-mono text-xs leading-8 text-primary">
            {formatTimestamp(paragraph.start)}
          </span>
          <span>{paragraph.text}</span>
        </p>
      ))
    }
  </div>
</details>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  details[open] .at-transcript-marker {
    transform: rotate(90deg);
  }
</style>
