---
import ChannelLogo from "./ChannelLogo.astro";
import type { ChannelType } from "../constants";

interface Props {
  // `type` adds the platform's logo before the label.
  channels: { label: string; href: string; type?: ChannelType }[];
}

const { channels } = Astro.props;
---

<ul class="flex flex-wrap items-center gap-2">
  {
    channels.map((channel) => (
      <li>
        <a
          href={channel.href}
          class="flex min-h-10 items-center gap-2 rounded-full border border-line-strong px-4 text-sm text-soft transition-colors duration-150 hover:border-primary hover:text-primary"
          target="_blank"
          referrerpolicy="no-referrer"
        >
          {channel.type && (
            <ChannelLogo type={channel.type} class="-ml-1.5 size-5 rounded-[5px]" />
          )}
          {channel.label} ↗
        </a>
      </li>
    ))
  }
</ul>
