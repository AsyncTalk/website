---
interface Props {
  channels: { label: string; href: string }[];
}

const { channels } = Astro.props;
---

<ul class="flex flex-wrap items-center gap-2">
  {
    channels.map((channel) => (
      <li>
        <a
          href={channel.href}
          class="flex min-h-10 items-center rounded-full border border-line-strong px-4 text-sm text-soft transition-colors duration-150 hover:border-primary hover:text-primary"
          target="_blank"
          referrerpolicy="no-referrer"
        >
          {channel.label} ↗
        </a>
      </li>
    ))
  }
</ul>
