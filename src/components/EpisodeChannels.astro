---
import IconExternalLink from "./icons/external-link.astro";

interface Props {
  channels: { label: string; href: string }[];
}

const { channels } = Astro.props;
---

<ul class="flex flex-wrap items-center gap-2">
  {
    channels.map((channel) => (
      <li>
        <a
          href={channel.href}
          class="at-channel flex items-center gap-1 rounded-full border border-white/15 px-3 py-1 text-sm text-white/70 transition-colors duration-150"
          target="_blank"
          referrerpolicy="no-referrer"
        >
          {channel.label}
          <IconExternalLink className="h-3.5 w-3.5" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .at-channel:hover {
    border-color: var(--at-primary-color);
    color: var(--at-primary-color);
  }
</style>
