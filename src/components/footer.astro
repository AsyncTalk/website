---
import TitleDark from "../images/title.png";
import TitleLight from "../images/title-light.png";
import { authors, evonia } from "../constants";
---

<footer class="w-full border-t border-line">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-8 px-4 pb-8 pt-10 sm:px-6 md:flex-row md:items-start md:justify-between"
  >
    <div class="flex flex-col gap-3">
      <picture>
        <source srcset={TitleDark.src} media="(prefers-color-scheme: dark)" />
        <img
          src={TitleLight.src}
          alt="AsyncTalk"
          width="150"
          height="34"
          loading="lazy"
          class="h-auto w-[150px]"
        />
      </picture>
      <p class="text-[13px] text-mute">
        和我们一起，将 Web 开发带向下一个高度
      </p>
    </div>
    <nav aria-label="页脚">
      <ul
        class="flex flex-wrap items-center gap-x-7 text-[13px] text-primary"
      >
        <li>
          <a href="/posts/" class="flex min-h-11 items-center hover:underline"
            >全部节目</a
          >
        </li>
        <li>
          <a href="/rss.xml" class="flex min-h-11 items-center hover:underline"
            >RSS</a
          >
        </li>
        {
          authors.map((x) => (
            <li>
              {x.link ? (
                <a
                  href={x.link}
                  target="_blank"
                  class="flex min-h-11 items-center hover:underline"
                >
                  {x.name}
                </a>
              ) : (
                <span class="flex min-h-11 items-center">{x.name}</span>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="mx-auto max-w-6xl px-4 pb-8 sm:px-6">
    <a
      href={evonia.url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 items-center gap-2 text-xs text-mute transition-colors duration-100 hover:text-ink"
    >
      <picture>
        <source srcset={evonia.logoDark} media="(prefers-color-scheme: dark)" />
        <img src={evonia.logo} alt="" width="16" height="16" loading="lazy" />
      </picture>
      <span>Powered by {evonia.name}</span>
    </a>
  </div>
</footer>
