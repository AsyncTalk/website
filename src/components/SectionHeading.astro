---
interface Props {
  index: string;
  title: string;
  as?: "h2" | "h3";
}

const { index, title, as: Tag = "h2" } = Astro.props;
---

<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
  <Tag
    class="flex items-baseline gap-4 font-display text-2xl font-bold text-ink sm:text-[28px]"
  >
    <span class="font-mono text-[13px] font-normal text-primary">{index}</span>
    {title}
  </Tag>
  <slot />
</div>
<hr class="at-rule mb-10 mt-4" />
