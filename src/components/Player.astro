---
interface Props {
  link: string;
  title: string;
  label?: string;
  external?: boolean;
}

const { link, title, label = "立即播放", external = true } = Astro.props;
---

<a
  href={link}
  target={external ? "_blank" : undefined}
  referrerpolicy={external ? "no-referrer" : undefined}
  class="flex max-w-full items-center gap-4 self-start rounded-xl border border-primary py-3.5 pl-5 pr-7 text-ink transition duration-300 hover:bg-primary-soft active:scale-[0.98]"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="currentColor"
    class="size-9 shrink-0 text-primary"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M15.91 11.672a.375.375 0 0 1 0 .656l-5.603 3.113a.375.375 0 0 1-.557-.328V8.887c0-.286.307-.466.557-.327l5.603 3.112Z"
    ></path>
  </svg>
  <span class="flex min-w-0 flex-col leading-snug">
    <span class="text-xs text-soft">{label}{external && " ↗"}</span>
    <span class="text-[17px] font-bold">{title}</span>
  </span>
</a>
