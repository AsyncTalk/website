---
import { Image } from "astro:assets";
import logo from "../images/logo.png";
import IconYouTube from "./icons/youtube.astro";
import IconBilibili from "./icons/bilibili.astro";
import IconXiaohongshu from "./icons/xiaohongshu.astro";
import { podcastChannels, socialLinks } from "../constants";

const path = Astro.url.pathname;
const onEpisodeIndex = path === "/posts/" || path.startsWith("/posts/page/");
---

<header
  class="sticky top-0 z-10 w-full border-b border-line bg-header backdrop-blur"
>
  <div
    class="mx-auto flex w-full max-w-6xl select-none items-center justify-between gap-4 whitespace-nowrap px-4 py-3 sm:px-6"
  >
    <div class="flex min-w-0 items-center gap-7">
      <a
        href="/"
        class="flex min-h-11 items-center gap-3 text-[15px] text-ink/90 transition-colors duration-100 hover:text-ink"
      >
        <Image
          src={logo}
          alt="Async Talk"
          width={32}
          height={32}
          class="rounded-md"
        />
        <span class="hidden sm:inline">Async Talk Podcast</span>
      </a>
      <nav aria-label="收听渠道" class="hidden lg:block">
        <ul class="flex items-center gap-5 text-sm text-soft">
          {
            podcastChannels.map((x) => (
              <li>
                <a
                  href={x.link}
                  class="flex min-h-11 items-center transition-colors duration-100 hover:text-ink"
                  target="_blank"
                  referrerpolicy="no-referrer"
                >
                  {x.title} ↗
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <div class="flex items-center gap-1">
      <ul class="flex items-center text-soft">
        {
          socialLinks.map((s) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                title={s.label}
                class="flex size-11 items-center justify-center transition-colors duration-100 hover:text-ink"
              >
                {s.type === "youtube" && <IconYouTube className="h-5 w-5" />}
                {s.type === "bilibili" && <IconBilibili className="h-5 w-5" />}
                {s.type === "xiaohongshu" && (
                  <IconXiaohongshu className="h-5 w-5" />
                )}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="/posts/"
        aria-current={onEpisodeIndex ? "page" : undefined}
        class:list={[
          "ml-2 flex min-h-10 items-center rounded-full border px-4 text-sm transition-colors duration-150 hover:border-primary hover:text-primary",
          onEpisodeIndex
            ? "border-primary text-primary"
            : "border-line-strong text-ink/90",
        ]}
      >
        全部节目
      </a>
    </div>
  </div>
</header>
