---
import { Image } from "astro:assets";

interface Props {
  cover: ImageMetadata;
  title: string;
}

const { cover, title } = Astro.props;
---

<Image
  src={cover}
  alt={`${title} 节目封面`}
  widths={[200, 300, 400, 600]}
  sizes="(min-width: 768px) 300px, 200px"
  loading="eager"
  class="h-auto w-[200px] shrink-0 rounded-xl shadow-cover md:w-[300px]"
/>
