const { type, class: className = "size-10" } = Astro.props;
const mark = marks[type];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class:list={["shrink-0", className]}
  aria-hidden="true"
>
  {
    mark.tile ? (
      <>
        <rect width="24" height="24" rx="5.4" fill={mark.color} />
        {type === "xiaoyuzhou" ? (
          <>
            <ellipse
              cx="12"
              cy="12"
              rx="8.6"
              ry="2.7"
              fill="none"
              stroke="#fff"
              stroke-width="1.5"
              transform="rotate(-24 12 12)"
            />
            <circle cx="12" cy="12" r="4.6" fill="#fff" />
          </>
        ) : (
          <path
            d={mark.path}
            fill="#fff"
            transform="translate(12 12) scale(0.8) translate(-12 -12)"
          />
        )}
      </>
    ) : (
      <path d={mark.path} fill={mark.color} />
    )
  }
</svg>
