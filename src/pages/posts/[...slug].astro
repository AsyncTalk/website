---
import { render } from "astro:content";
import PageLayout from "../../layouts/Layout.astro";
import SEOTags from "../../components/seo/seo-tags.astro";
import WarningAlert from "../../components/alert/warning.astro";
import Tags from "../../components/tags/tags.astro";

import Heading1 from "../../components/markdown/Heading1.astro";
import Heading2 from "../../components/markdown/Heading2.astro";
import Heading3 from "../../components/markdown/Heading3.astro";
import Heading4 from "../../components/markdown/Heading4.astro";
import Heading5 from "../../components/markdown/Heading5.astro";
import Heading6 from "../../components/markdown/Heading6.astro";
import Hr from "../../components/markdown/Hr.astro";
import A from "../../components/markdown/A.astro";
import P from "../../components/markdown/P.astro";
import type { InferGetStaticPropsType } from "astro";
import Player from "../../components/Player.astro";
import AdSense from "../../components/AdSense.astro";
import VideoEmbed from "../../components/VideoEmbed.astro";
import SlidesEmbed from "../../components/SlidesEmbed.astro";
import EpisodeCover from "../../components/EpisodeCover.astro";
import EpisodeChannels from "../../components/EpisodeChannels.astro";
import Transcript from "../../components/Transcript.astro";
import EpisodeTimeline from "../../components/EpisodeTimeline.astro";
import { SLIDES_BASE_URL } from "../../constants";
import { readEpisodeSubtitles } from "../../lib/episode-media";
import {
  formatEpisodeDate,
  getEpisodes,
  splitEpisodeTitle,
} from "../../lib/episodes";
import { groupCues, parseSrt } from "../../lib/srt";
import {
  SITE_URL,
  bilibiliUrl as getBilibiliUrl,
  canonicalUrl,
  compactUrls,
  episodePath,
  jsonLd,
  parseAuthors,
  youtubeUrl,
} from "../../lib/seo";

export async function getStaticPaths() {
  // Newest first, so the previous episode is the next entry in the list.
  const posts = await getEpisodes();

  return posts.map((post, index) => ({
    params: {
      slug: post.id.replace(/^\/?posts\//, ''),
    },
    props: {
      post,
      newer: posts[index - 1],
      older: posts[index + 1],
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, newer, older } = Astro.props;
const episodeTitle = splitEpisodeTitle(post);
const neighbours = [
  { label: "← 上一期", post: older, align: "" },
  { label: "下一期 →", post: newer, align: "sm:items-end sm:text-right" },
];

const { Content } = await render(post);

const isPreRelease = post.data.status !== "published";
const frontData = post.data;
const tags = frontData.categories;
const slug = post.id.replace(/^\/?posts\//, "");
const slidesSrc =
  frontData.slidesUrl ?? `${SLIDES_BASE_URL}/${slug}/`;
const pagePath = episodePath(post.id);
const pageUrl = canonicalUrl(pagePath, Astro.site);
const imgUrl = new URL(
  `${pagePath.replace(/\/$/, "")}-og.png`,
  Astro.site ?? SITE_URL,
).toString();
const podcastId = `${new URL("/", Astro.site ?? SITE_URL)}#podcast`;
const organizationId = `${new URL("/", Astro.site ?? SITE_URL)}#organization`;
const authorEntities = parseAuthors(frontData.author);
const xyzHref = frontData.xyzLink || undefined;
const youtubeHref = youtubeUrl(frontData.youtubeId);
const biliHref = getBilibiliUrl(frontData.biliUrl);
const sameAs = compactUrls([xyzHref, youtubeHref, biliHref]);
const channels = [
  { label: "小宇宙", href: xyzHref },
  { label: "YouTube", href: youtubeHref },
  { label: "Bilibili", href: biliHref },
  { label: "Notion 草稿", href: frontData.draftLink },
].filter((channel): channel is { label: string; href: string } =>
  Boolean(channel.href),
);
const title = `${frontData.title}｜AsyncTalk`;

const cover = frontData.cover;
const coverUrl = cover
  ? new URL(cover.src, Astro.site ?? SITE_URL).toString()
  : undefined;
const subtitles = frontData.srt
  ? readEpisodeSubtitles(frontData.srt)
  : undefined;
const transcript = subtitles ? groupCues(parseSrt(subtitles)) : [];
const timeline = frontData.timeline ?? [];
const transcriptText = transcript.map((paragraph) => paragraph.text).join("\n");
---

<PageLayout>
  <SEOTags
    slot="seo"
    title={title}
    description={frontData.excerpt}
    canonicalPath={pagePath}
    type="article"
    publishedTime={frontData.publicationDate}
    tags={tags}
    imageUrl={imgUrl}
    imageAlt={`${frontData.title} 节目封面`}
    noindex={isPreRelease}
  >
    <script
      slot="jsonld"
      type="application/ld+json"
      is:inline
      set:html={jsonLd({
        "@context": "https://schema.org",
        "@type": "PodcastEpisode",
        "@id": `${pageUrl}#episode`,
        url: pageUrl,
        name: frontData.title,
        description: frontData.excerpt,
        datePublished: frontData.publicationDate.toISOString(),
        inLanguage: "zh-CN",
        episodeNumber: frontData.episodeNumber,
        image: coverUrl ? [coverUrl, imgUrl] : imgUrl,
        isAccessibleForFree: true,
        ...(transcriptText ? { transcript: transcriptText } : {}),
        keywords: tags,
        author: authorEntities,
        publisher: { "@id": organizationId },
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": pageUrl,
        },
        partOfSeries: { "@id": podcastId },
        partOfSeason: {
          "@type": "PodcastSeason",
          seasonNumber: frontData.season,
          partOfSeries: { "@id": podcastId },
        },
        ...(sameAs.length > 0 ? { sameAs } : {}),
      })}
    />
  </SEOTags>
  <div class="mx-auto w-full max-w-6xl px-4 pb-24 pt-6 sm:px-6 sm:pt-8">
    <nav
      aria-label="面包屑"
      class="flex items-center gap-2.5 font-mono text-[13px] text-mute"
    >
      <a
        href="/posts/"
        class="flex min-h-11 items-center text-soft hover:underline"
      >
        ← 全部节目
      </a>
      <span aria-hidden="true">/</span>
      <span>{episodeTitle.code}</span>
    </nav>

    {
      isPreRelease && (
        <WarningAlert
          title="预发布内容"
          description="请注意. 此内容正在预发布中，内容可能会更改."
        />
      )
    }

    <header
      class="mt-4 flex flex-col gap-8 md:mt-6 md:flex-row md:items-start md:gap-14"
    >
      {cover && <EpisodeCover cover={cover} title={frontData.title} />}
      <div class="flex min-w-0 flex-1 flex-col gap-5">
        <p
          class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-[13px] text-mute"
        >
          <span class="text-primary">{episodeTitle.code}</span>
          <time
            datetime={frontData.publicationDate.toISOString()}
            title={frontData.publicationDate.toISOString()}
          >
            {formatEpisodeDate(frontData.publicationDate)}
          </time>
          <span>{frontData.author}</span>
        </p>
        <h1
          class="at-gradient-title font-display text-[28px] font-bold leading-tight sm:text-[44px] sm:leading-tight"
        >
          {frontData.title}
        </h1>
        <p class="max-w-2xl leading-loose text-soft">
          {frontData.excerpt}
        </p>
        {
          post.data.xyzLink && (
            <Player link={post.data.xyzLink} title="在小宇宙收听本期" />
          )
        }
        {channels.length > 0 && <EpisodeChannels channels={channels} />}
        {tags.length > 0 && <Tags tags={tags} />}
      </div>
    </header>

    <Hr className="my-10 sm:my-14" />

    {
      frontData.youtubeId && (
        <section aria-label="视频" class="mb-14">
          <VideoEmbed
            youtubeId={frontData.youtubeId}
            bilibiliUrl={frontData.biliUrl}
          />
        </section>
      )
    }

    {
      (frontData.hasSlides || frontData.slidesUrl) && (
        <section aria-label="幻灯片" class="mb-14">
          <SlidesEmbed src={slidesSrc} title={frontData.title} />
        </section>
      )
    }

    {
      frontData.srt && transcript.length > 0 && (
        <section aria-label="文字稿" class="mb-14">
          <Transcript paragraphs={transcript} srcUrl={frontData.srt} />
        </section>
      )
    }

    <div class="flex flex-wrap items-start gap-x-16 gap-y-12">
      <article
        class:list={[
          "at-mdx-content min-w-0 break-words leading-loose text-body",
          timeline.length > 0 ? "flex-[999_1_520px]" : "w-full max-w-3xl",
        ]}
      >
        <Content
          components={{
            h1: Heading1,
            h2: Heading2,
            h3: Heading3,
            h4: Heading4,
            h5: Heading5,
            h6: Heading6,
            hr: Hr,
            a: A,
            p: P,
          }}
        />
        {
          frontData.credit && (
            <p class="mt-8 text-[13px] leading-relaxed text-mute">
              {frontData.credit}
            </p>
          )
        }
      </article>
      {timeline.length > 0 && <EpisodeTimeline items={timeline} />}
    </div>

    <Hr className="my-10 sm:my-14" />

    <nav aria-label="上下期" class="grid gap-4 sm:grid-cols-2">
      {
        neighbours.map(({ label, post: neighbour, align }) => {
          const box = `flex flex-col gap-1.5 rounded-xl border border-line px-6 py-5 ${align}`;
          if (!neighbour) {
            return (
              <a
                href="/posts/"
                class={`${box} transition-colors duration-150 hover:border-primary`}
              >
                <span class="font-mono text-xs text-mute">全部节目 →</span>
                <span class="font-display text-[19px] font-bold leading-normal text-ink">
                  浏览全部节目
                </span>
              </a>
            );
          }
          const { code, name } = splitEpisodeTitle(neighbour);
          return (
            <a
              href={episodePath(neighbour.id)}
              class={`${box} transition-colors duration-150 hover:border-primary`}
            >
              <span class="font-mono text-xs text-mute">
                {label} · <span class="text-primary">{code}</span>
              </span>
              <span class="font-display text-[19px] font-bold leading-normal text-ink">
                {name}
              </span>
            </a>
          );
        })
      }
    </nav>

    <div class="mt-10">
      <AdSense />
    </div>
  </div>
</PageLayout>
