---
import { getCollection, render } from "astro:content";
import PageLayout from "../../layouts/Layout.astro";
import SEOTags from "../../components/seo/seo-tags.astro";
import WarningAlert from "../../components/alert/warning.astro";
import Tags from "../../components/tags/tags.astro";

import Heading1 from "../../components/markdown/Heading1.astro";
import Heading2 from "../../components/markdown/Heading2.astro";
import Heading3 from "../../components/markdown/Heading3.astro";
import Heading4 from "../../components/markdown/Heading4.astro";
import Heading5 from "../../components/markdown/Heading5.astro";
import Heading6 from "../../components/markdown/Heading6.astro";
import Hr from "../../components/markdown/Hr.astro";
import A from "../../components/markdown/A.astro";
import P from "../../components/markdown/P.astro";
import type { InferGetStaticPropsType } from "astro";
import Player from "../../components/Player.astro";
import AdSense from "../../components/AdSense.astro";
import VideoEmbed from "../../components/VideoEmbed.astro";
import SlidesEmbed from "../../components/SlidesEmbed.astro";
import EpisodeCover from "../../components/EpisodeCover.astro";
import EpisodeChannels from "../../components/EpisodeChannels.astro";
import Transcript from "../../components/Transcript.astro";
import { SLIDES_BASE_URL } from "../../constants";
import { readEpisodeSubtitles } from "../../lib/episode-media";
import { groupCues, parseSrt } from "../../lib/srt";
import {
  SITE_URL,
  bilibiliUrl as getBilibiliUrl,
  canonicalUrl,
  compactUrls,
  episodePath,
  jsonLd,
  parseAuthors,
  youtubeUrl,
} from "../../lib/seo";

export async function getStaticPaths() {
  const posts = await getCollection(
    "posts",
    ({ data }) => !import.meta.env.PROD || data.status === "published",
  );

  return posts.map((post) => ({
    params: {
      slug: post.id.replace(/^\/?posts\//, ''),
    },
    props: {
      post,
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const post = Astro.props.post;

const { Content } = await render(post);

const isPreRelease = post.data.status !== "published";
const frontData = post.data;
const tags = frontData.categories;
const slug = post.id.replace(/^\/?posts\//, "");
const slidesSrc =
  frontData.slidesUrl ?? `${SLIDES_BASE_URL}/${slug}/`;
const pagePath = episodePath(post.id);
const pageUrl = canonicalUrl(pagePath, Astro.site);
const imgUrl = new URL(
  `${pagePath.replace(/\/$/, "")}-og.png`,
  Astro.site ?? SITE_URL,
).toString();
const podcastId = `${new URL("/", Astro.site ?? SITE_URL)}#podcast`;
const organizationId = `${new URL("/", Astro.site ?? SITE_URL)}#organization`;
const authorEntities = parseAuthors(frontData.author);
const xyzHref = frontData.xyzLink || undefined;
const youtubeHref = youtubeUrl(frontData.youtubeId);
const biliHref = getBilibiliUrl(frontData.biliUrl);
const sameAs = compactUrls([xyzHref, youtubeHref, biliHref]);
const channels = [
  { label: "小宇宙", href: xyzHref },
  { label: "YouTube", href: youtubeHref },
  { label: "Bilibili", href: biliHref },
  { label: "Notion 草稿", href: frontData.draftLink },
].filter((channel): channel is { label: string; href: string } =>
  Boolean(channel.href),
);
const title = `${frontData.title}｜AsyncTalk`;

const cover = frontData.cover;
const coverUrl = cover
  ? new URL(cover.src, Astro.site ?? SITE_URL).toString()
  : undefined;
const subtitles = frontData.srt
  ? readEpisodeSubtitles(frontData.srt)
  : undefined;
const transcript = subtitles ? groupCues(parseSrt(subtitles)) : [];
const transcriptText = transcript.map((paragraph) => paragraph.text).join("\n");
---

<PageLayout>
  <SEOTags
    slot="seo"
    title={title}
    description={frontData.excerpt}
    canonicalPath={pagePath}
    type="article"
    publishedTime={frontData.publicationDate}
    tags={tags}
    imageUrl={imgUrl}
    imageAlt={`${frontData.title} 节目封面`}
    noindex={isPreRelease}
  >
    <script
      slot="jsonld"
      type="application/ld+json"
      is:inline
      set:html={jsonLd({
        "@context": "https://schema.org",
        "@type": "PodcastEpisode",
        "@id": `${pageUrl}#episode`,
        url: pageUrl,
        name: frontData.title,
        description: frontData.excerpt,
        datePublished: frontData.publicationDate.toISOString(),
        inLanguage: "zh-CN",
        episodeNumber: frontData.episodeNumber,
        image: coverUrl ? [coverUrl, imgUrl] : imgUrl,
        isAccessibleForFree: true,
        ...(transcriptText ? { transcript: transcriptText } : {}),
        keywords: tags,
        author: authorEntities,
        publisher: { "@id": organizationId },
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": pageUrl,
        },
        partOfSeries: { "@id": podcastId },
        partOfSeason: {
          "@type": "PodcastSeason",
          seasonNumber: frontData.season,
          partOfSeries: { "@id": podcastId },
        },
        ...(sameAs.length > 0 ? { sameAs } : {}),
      })}
    />
  </SEOTags>
  <div
    class="min-h-[250px] m-auto max-w-screen-lg text-gray-100 w-full px-4 md:pt-10"
  >
    {
      isPreRelease && (
        <WarningAlert
          title="预发布内容"
          description="请注意. 此内容正在预发布中，内容可能会更改."
        />
      )
    }
    <header class="flex flex-col md:flex-row md:items-start gap-5">
      {cover && <EpisodeCover cover={cover} title={frontData.title} />}
      <div class="min-w-0 flex flex-col gap-4">
        <div>
          <time
            class="text-xs text-white/45"
            datetime={frontData.publicationDate.toISOString()}
            title={frontData.publicationDate.toISOString()}
          >
            {new Intl.DateTimeFormat("zh-CN").format(frontData.publicationDate)}
          </time>
          <h1 class="mt-2 text-3xl font-extrabold at-post-title">
            {frontData.title}
          </h1>
          <p class="mt-3 text-base leading-7 text-white/70">
            {frontData.excerpt}
          </p>
        </div>
        {channels.length > 0 && <EpisodeChannels channels={channels} />}
        {tags.length > 0 && <Tags tags={tags} />}
      </div>
    </header>

    <Hr className="my-10" />
    {
      post.data.xyzLink && (
        <>
          <Player link={post.data.xyzLink} title={frontData.title} />
          <Hr className="my-10" />
        </>
      )
    }

    {
      frontData.youtubeId && (
        <>
          <VideoEmbed
            youtubeId={frontData.youtubeId}
            bilibiliUrl={frontData.biliUrl}
          />
          <Hr className="my-10" />
        </>
      )
    }

    {
      (frontData.hasSlides || frontData.slidesUrl) && (
        <>
          <SlidesEmbed src={slidesSrc} title={frontData.title} />
          <Hr className="my-10" />
        </>
      )
    }

    {
      frontData.srt && transcript.length > 0 && (
        <>
          <Transcript paragraphs={transcript} srcUrl={frontData.srt} />
          <Hr className="my-10" />
        </>
      )
    }

    <article
      class="leading-loose w-full at-mdx-content at-scrollbar text-gray-100 break-all"
    >
      <Content
        components={{
          h1: Heading1,
          h2: Heading2,
          h3: Heading3,
          h4: Heading4,
          h5: Heading5,
          h6: Heading6,
          hr: Hr,
          a: A,
          p: P,
        }}
      />
      <Hr className="my-10" />
      <AdSense />
    </article>
  </div>
</PageLayout>

<style>
  .at-post-title {
    background-image: linear-gradient(
      90deg,
      oklch(65.82% 0.04 263.51 / 92.94%),
      var(--at-primary-color)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>
