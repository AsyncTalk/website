---
import PageLayout from "../layouts/Layout.astro";
import SEOTags from "../components/seo/seo-tags.astro";
import ChannelLogo from "../components/ChannelLogo.astro";
import { authors, listenChannels } from "../constants";

const title = "关于｜AsyncTalk";
const description =
  "AsyncTalk 是一档关注 Web 开发、前端工程化与 AI 的中文播客。了解节目方向、主播，以及在小宇宙、YouTube、Bilibili 和 RSS 上收听的方式。";
---

<PageLayout>
  <SEOTags
    slot="seo"
    title={title}
    description={description}
    canonicalPath="/about/"
  />

  <article class="mx-auto w-full max-w-3xl px-4 pb-24 pt-12 sm:px-6 sm:pt-16">
    <p class="font-mono text-[13px] text-primary">About</p>
    <h1
      class="mt-3 font-display text-[32px] font-bold leading-tight text-ink sm:text-[44px]"
    >
      关于 AsyncTalk
    </h1>
    <p class="mt-6 text-[17px] leading-loose text-soft">
      AsyncTalk 是一档以中文（华语）讨论 Web 开发技术的播客。我们关注 Web 开发、前端工程化与 AI，分享前沿技术、工程实践与开发者观点。和我们一起，将 Web 开发带向下一个高度。
    </p>

    <div class="mt-12 space-y-12 text-[17px] leading-loose text-soft">
      <section class="space-y-4">
        <h2 class="font-display text-2xl font-bold text-ink">节目在聊什么</h2>
        <p>
          节目面向对 Web 开发感兴趣的朋友。早期内容从介绍节目本身和工程实践开始，后来的单集继续围绕前端、工具链、职业话题，以及 AI 进入日常开发之后的工作方式。每一期的标题、简介和文字稿（如果有）都放在对应的节目页里，全部期数可以在
          <a href="/posts/" class="text-primary hover:underline">全部节目</a>
          里按时间往回看。
        </p>
        <p>
          音频会发到常见的播客平台。视频版和幕后内容则在 YouTube、Bilibili 和小红书更新。网站同时提供
          <a href="/rss.xml" class="text-primary hover:underline">RSS</a>
          ，方便用自己的播客客户端订阅。
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="font-display text-2xl font-bold text-ink">主播</h2>
        <p>目前网站上列出的主播是：</p>
        <ul class="space-y-3">
          {
            authors.map((host) => (
              <li class="flex items-baseline gap-3">
                <span class="text-ink">{host.name}</span>
                {host.link ? (
                  <a
                    href={host.link}
                    class="text-primary hover:underline"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {host.link.replace(/^https?:\/\//, "")} ↗
                  </a>
                ) : (
                  <span class="text-sm text-mute">主播</span>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="space-y-4">
        <h2 class="font-display text-2xl font-bold text-ink">在哪里收听</h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {
            listenChannels.map((channel) => (
              <li>
                <a
                  href={channel.link}
                  target={channel.link.startsWith("http") ? "_blank" : undefined}
                  rel={channel.link.startsWith("http") ? "noopener noreferrer" : undefined}
                  class="flex items-center gap-3 rounded-xl border border-line px-4 py-3 text-ink transition-colors duration-150 hover:border-primary"
                >
                  <ChannelLogo type={channel.type} class="size-8 rounded-md" />
                  <span class="flex min-w-0 flex-1 flex-col leading-normal">
                    <span>{channel.title}</span>
                    <span class="text-xs text-mute">{channel.kind}</span>
                  </span>
                  <span aria-hidden="true" class="text-primary">
                    ↗
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <p>
          小宇宙、YouTube、Bilibili 和 RSS 都可以从这里进入。Apple Podcast 与 Spotify 的节目页，以及小红书，也使用网站里已有的同一组链接。
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="font-display text-2xl font-bold text-ink">意见与这个网站</h2>
        <p>
          如果有任何意见或建议，不需要特定格式，发邮件到
          <a
            href="mailto:async.talk@gmail.com"
            class="text-primary hover:underline">async.talk@gmail.com</a
          >
          即可。在 GitHub 仓库
          <a
            href="https://github.com/AsyncTalk/website"
            class="text-primary hover:underline"
            target="_blank"
            rel="noopener noreferrer">AsyncTalk/website ↗</a
          >
          里开 issue 也可以。更多联系方式写在
          <a href="/contact/" class="text-primary hover:underline">联系我们</a>
          ，广告与 Cookie 的说明写在
          <a href="/privacy/" class="text-primary hover:underline">隐私政策</a>
          。
        </p>
      </section>
    </div>
  </article>
</PageLayout>
