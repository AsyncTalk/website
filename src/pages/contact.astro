---
import PageLayout from "../layouts/Layout.astro";
import SEOTags from "../components/seo/seo-tags.astro";
import ChannelLogo from "../components/ChannelLogo.astro";
import { authors, socialLinks } from "../constants";

const title = "联系我们｜AsyncTalk";
const description =
  "联系 AsyncTalk：意见与建议请发邮件至 async.talk@gmail.com，也可以通过 YouTube、Bilibili、小红书、X 或 GitHub 找到我们。";
---

<PageLayout>
  <SEOTags
    slot="seo"
    title={title}
    description={description}
    canonicalPath="/contact/"
  />

  <article class="mx-auto w-full max-w-3xl px-4 pb-24 pt-12 sm:px-6 sm:pt-16">
    <p class="font-mono text-[13px] text-primary">Contact</p>
    <h1
      class="mt-3 font-display text-[32px] font-bold leading-tight text-ink sm:text-[44px]"
    >
      联系我们
    </h1>
    <p class="mt-6 text-[17px] leading-loose text-soft">
      如果你有任何意见或者建议，无需顾及格式，可以直接发邮件。节目、网站和隐私相关的问题都使用下面同一个地址。
    </p>

    <div class="mt-12 space-y-12 text-[17px] leading-loose text-soft">
      <section class="space-y-4">
        <h2 class="font-display text-2xl font-bold text-ink">邮件</h2>
        <p>
          <a
            href="mailto:async.talk@gmail.com"
            class="font-display text-2xl text-primary hover:underline"
            >async.talk@gmail.com</a
          >
        </p>
        <p>
          这是网站说明和多期节目里一直使用的联系邮箱。隐私政策里的问题也可以发到这里，我们会在这个邮箱回复。
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="font-display text-2xl font-bold text-ink">社交与视频</h2>
        <p>页头和首页「收听渠道」里的社交账号：</p>
        <ul class="grid gap-3 sm:grid-cols-2">
          {
            socialLinks.map((link) => (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3 rounded-xl border border-line px-4 py-3 text-ink transition-colors duration-150 hover:border-primary"
                >
                  <ChannelLogo type={link.type} class="size-8 rounded-md" />
                  <span class="min-w-0 flex-1">{link.label}</span>
                  <span aria-hidden="true" class="text-primary">
                    ↗
                  </span>
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="https://x.com/AsyncTalk"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 rounded-xl border border-line px-4 py-3 text-ink transition-colors duration-150 hover:border-primary"
            >
              <span class="min-w-0 flex-1">X（@asynctalk）</span>
              <span aria-hidden="true" class="text-primary">↗</span>
            </a>
          </li>
        </ul>
        <p class="text-sm text-mute">
          YouTube、Bilibili 和小红书来自站点配置。X 账号与页面里的
          <span class="text-ink">@asynctalk</span> 以及节目备注中的链接一致。
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="font-display text-2xl font-bold text-ink">GitHub</h2>
        <p>
          网站仓库是
          <a
            href="https://github.com/AsyncTalk/website"
            class="text-primary hover:underline"
            target="_blank"
            rel="noopener noreferrer">github.com/AsyncTalk/website ↗</a
          >。关于网站本身的问题，在
          <a
            href="https://github.com/AsyncTalk/website/issues"
            class="text-primary hover:underline"
            target="_blank"
            rel="noopener noreferrer">Issues ↗</a
          >
          里提出即可，不需要特定模板。
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="font-display text-2xl font-bold text-ink">主播</h2>
        <ul class="space-y-3">
          {
            authors.map((host) => (
              <li>
                {host.link ? (
                  <a
                    href={host.link}
                    class="text-primary hover:underline"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {host.name} ↗
                  </a>
                ) : (
                  <span class="text-ink">{host.name}</span>
                )}
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </article>
</PageLayout>
