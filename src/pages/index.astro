---
import BgImg from "../images/bg-fm.png";
import PageLayout from "../layouts/Layout.astro";
import SEOTags from "../components/seo/seo-tags.astro";
import TitleImage from "../images/title.png";
import { podcastLinks, socialLinks } from "../constants";
import { SITE_URL, compactUrls, jsonLd } from "../lib/seo";

const title = "AsyncTalk｜和我们一起，将 Web 开发带向下一个高度";
const description =
  "AsyncTalk 是一档关注 Web 开发、前端工程化与 AI 的中文播客，分享前沿技术、工程实践与开发者观点。和我们一起，将 Web 开发带向下一个高度。";
const homeUrl = new URL("/", Astro.site ?? SITE_URL).toString();
const organizationId = `${homeUrl}#organization`;
const podcastId = `${homeUrl}#podcast`;
const logoUrl = new URL("/android-chrome-512x512.png", homeUrl).toString();
const sameAs = compactUrls([
  ...Object.values(podcastLinks),
  ...socialLinks.map((link) => link.url),
]);
---

<PageLayout>
  <SEOTags
    slot="seo"
    title={title}
    description={description}
    canonicalPath="/"
  >
    <script
      slot="jsonld"
      type="application/ld+json"
      is:inline
      set:html={jsonLd({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": `${homeUrl}#website`,
            url: homeUrl,
            name: "AsyncTalk",
            alternateName: ["Async Talk Podcast", "asynctalk.com"],
            inLanguage: "zh-CN",
            publisher: { "@id": organizationId },
          },
          {
            "@type": "Organization",
            "@id": organizationId,
            url: homeUrl,
            name: "AsyncTalk",
            logo: {
              "@type": "ImageObject",
              url: logoUrl,
              width: 512,
              height: 512,
            },
            sameAs,
          },
          {
            "@type": "PodcastSeries",
            "@id": podcastId,
            url: homeUrl,
            name: "AsyncTalk",
            description,
            inLanguage: "zh-CN",
            image: new URL("/og.png", homeUrl).toString(),
            webFeed: new URL("/rss.xml", homeUrl).toString(),
            publisher: { "@id": organizationId },
            sameAs,
          },
        ],
      })}
    />
  </SEOTags>
  <section
    class="min-h-[70vh] m-auto max-w-screen-lg bg-black bg-[center_top_30%] bg-no-repeat sm:bg-[length:auto_50%] bg-[length:95%_auto]"
    style={{
      backgroundImage: `url(${BgImg.src})`,
    }}
  >
    <div class="min-h-[70vh] backdrop-blur-md">
      <div
        class="min-h-[70vh] select-none flex flex-col justify-center max-w-xl m-auto px-6"
      >
        <img
          draggable={false}
          class="text-center w-full h-auto"
          src={TitleImage.src}
          alt="AsyncTalk"
          width={1035}
          height={236}
          fetchpriority="high"
        />
        <h1 class="text-white mt-10 text-2xl italic text-right w-full">
          和我们一起，将 Web 开发带向下一个高度
        </h1>
        <p class="mt-5 text-sm leading-7 text-white/70 text-right">
          关注 Web 开发、前端工程化与 AI，分享前沿技术、工程实践与开发者观点。
        </p>
      </div>
    </div>
  </section>
</PageLayout>
