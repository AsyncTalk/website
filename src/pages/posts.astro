---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/Layout.astro";
import SEOTags from "../components/seo/seo-tags.astro";
import { episodePath } from "../lib/seo";

const posts = await getCollection(
  "posts",
  ({ data }) => !import.meta.env.PROD || data.status === "published",
);

posts.sort(
  (a, b) => b.data.publicationDate.valueOf() - a.data.publicationDate.valueOf(),
);

const title = "全部节目｜AsyncTalk";
const description =
  "浏览 AsyncTalk 全部中文播客节目，涵盖 Web 开发、前端工程化、JavaScript、AI、开发者工具与技术职业成长。";
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "Asia/Shanghai",
});
---

<PageLayout>
  <SEOTags
    slot="seo"
    title={title}
    description={description}
    canonicalPath="/posts/"
  />
  <section class="min-h-[250px] m-auto max-w-screen-lg py-8 px-4">
    <h1 class="text-3xl font-extrabold text-white">AsyncTalk 全部节目</h1>
    <p class="mt-3 text-white/70 leading-7">{description}</p>
    <ul class="mt-8 flex flex-col gap-6">
      {
        posts.map((post) => {
          const path = episodePath(post.id);
          return (
            <li>
              <article>
                <a href={path} class="group block">
                  <h2 class="text-xl text-teal-400 group-hover:underline">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 text-sm leading-6 text-white/70">
                    {post.data.excerpt}
                  </p>
                  <time
                    class="mt-2 block text-xs text-white/50"
                    datetime={post.data.publicationDate.toISOString()}
                  >
                    {dateFormatter.format(post.data.publicationDate)}
                  </time>
                </a>
              </article>
            </li>
          );
        })
      }
    </ul>
  </section>
</PageLayout>
